<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.6</Version>
    <Authors>Kia.Saeid</Authors>
    <Company>KiaIT.ir</Company>
    <Description>Companion utilities for RinneganCore: pagination, Jalali date helpers, formatting, and Persian string utilities.</Description>
    <PackageProjectUrl>https://github.com/saeidkia/Rinnegan</PackageProjectUrl>
    <RepositoryUrl>https://github.com/saeidkia/Rinnegan</RepositoryUrl>
    <PackageTags>Rinnegan;RinneganCore;Tools;Pagination;Jalali</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Companion package for RinneganCore. See CHANGELOG.md.</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.StaticFiles" Version="2.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
